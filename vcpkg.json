{
  "name": "opensupcom",
  "version-string": "0.1.0",
  "description": "Open-source engine reimplementation for Supreme Commander: Forged Alliance",
  "builtin-baseline": "78b7c910015e9c9d61c47d054cab5d41934e4e28",
  "dependencies": [
    "zlib",
    "minizip",
    "spdlog",
    "fmt",
    "glfw3",
    "vulkan-headers",
    {
      "name": "vulkan-loader",
      "features": [
        {
          "name": "xlib",
          "platform": "linux"
        },
        {
          "name": "xcb",
          "platform": "linux"
        },
        {
          "name": "wayland",
          "platform": "linux"
        }
      ]
    },
    "vulkan-memory-allocator",
    "vk-bootstrap",
    "shaderc",
    {
      "name": "catch2",
      "version>=": "3.0.1"
    },
    "nlohmann-json"
  ],
  "features": {
    "vulkan-validation": {
      "description": "Khronos Vulkan validation layer for debug builds (loaded via VK_ADD_LAYER_PATH)",
      "dependencies": [
        "vulkan-validationlayers"
      ]
    }
  }
}
