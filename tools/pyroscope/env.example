# What tools/pyroscope/cloud-login.sh writes to ~/.config/opensupcom/pyroscope-cloud.env
# (mode 600, outside the repository). In Grafana Cloud: your stack -> Pyroscope ->
# "Send profiles" shows the URL and the user (a number); the key is an access-policy
# token with only the profiles:write scope, so a leak can write profiles and nothing else.
PYROSCOPE_URL=https://profiles-prod-000.grafana.net
PYROSCOPE_USER=123456
PYROSCOPE_API_KEY=glc_...
